# Identity and Bot Core connection
GATEWAY_ACCOUNT_ID=account-1
BOT_CORE_URL=http://127.0.0.1:8080
BOT_API_TOKEN=zxcvbnm

# mock runs on macOS/Linux/Windows. wxautox4 uses callback listening; wxauto4
# falls back to foreground polling when the free package has no callback API.
WECHAT_DRIVER=mock
WECHAT_LISTEN_CHATS=文件传输助手,测试群
WECHAT_BOT_MENTION=@机器人昵称
WECHAT_POLL_INTERVAL_SECONDS=1

# Delivery and retry behavior
GATEWAY_POLL_TIMEOUT_SECONDS=20
GATEWAY_ACTION_LEASE_SECONDS=60
GATEWAY_HTTP_TIMEOUT_SECONDS=30
GATEWAY_EVENT_QUEUE_SIZE=500
GATEWAY_RETRY_MIN_SECONDS=1
GATEWAY_RETRY_MAX_SECONDS=30
GATEWAY_STATE_DB=gateway-state.sqlite3
