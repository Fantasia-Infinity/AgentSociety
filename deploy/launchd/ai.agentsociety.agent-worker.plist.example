<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.agentsociety.agent-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__CLI__</string>
    <string>worker</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_ENV_FILE</key>
    <string>__ENV_FILE__</string>
    <key>AGENT_WORKSPACE_ROOT</key>
    <string>__WORKSPACE__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/agent-worker.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/agent-worker.err.log</string>
</dict>
</plist>
