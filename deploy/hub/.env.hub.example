AGENT_HUB_TOKEN=replace-with-at-least-24-random-characters

# Public URL seen by devices and returned by the A2A Agent Card.
# No-domain mode: https://<VPS public IP>
# Domain mode:    https://hub.example.com
AGENT_HUB_PUBLIC_URL=https://203.0.113.10

# TLS mode: self-signed (default, requires AGENT_HUB_PUBLIC_IP)
#           letsencrypt (requires AGENT_HUB_DOMAIN)
AGENT_HUB_TLS_MODE=self-signed
AGENT_HUB_PUBLIC_IP=203.0.113.10
# AGENT_HUB_DOMAIN=hub.example.com

# PostgreSQL (used automatically when AGENT_HUB_DATABASE_URL is set)
AGENT_HUB_POSTGRES_USER=agenthub
AGENT_HUB_POSTGRES_PASSWORD=replace-with-a-long-random-password
AGENT_HUB_POSTGRES_DB=agenthub
AGENT_HUB_DATABASE_URL=postgresql://agenthub:replace-with-a-long-random-password@postgres:5432/agenthub

# Optional S3-compatible object storage for Artifact contents.
# AGENT_HUB_OBJECT_STORE_URL=s3://your-bucket/prefix
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Web management UI. Required to enable /web; at least 32 random characters.
AGENT_HUB_WEB_SECRET=replace-with-at-least-32-random-characters
# Set false only for local plain-HTTP debugging.
# AGENT_HUB_WEB_COOKIE_SECURE=true

# Optional OIDC login for the web UI and API. The token's "sub" must be
# pre-registered via hub_oidc_identities (register_oidc_identity).
# AGENT_HUB_OIDC_ISSUER=https://accounts.example.com
# AGENT_HUB_OIDC_AUDIENCE=agent-society-hub
