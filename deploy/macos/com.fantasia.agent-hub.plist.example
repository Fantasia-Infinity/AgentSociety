<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fantasia.agent-hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>export AGENT_HUB_TOKEN=&quot;$(/usr/bin/security find-generic-password -a 'your account' -s agent-hub-token -w)&quot; &amp;&amp; exec /absolute/path/to/AgentSociety/.venv/bin/agent-hub</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/absolute/path/to/AgentSociety</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/fantasia-agent-hub.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fantasia-agent-hub.err.log</string>
</dict>
</plist>
