{
  "name": "@agent-society/dsh-agent-society",
  "version": "0.2.0",
  "description": "AgentSociety Hub worker and dispatch tools as a DeepSeek Harness bundle",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fantasia-Infinity/AgentSociety.git",
    "directory": "dsh-plugin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./task-bridge": {
      "types": "./lib/task-bridge.d.ts",
      "default": "./lib/task-bridge.js"
    },
    "./worker": {
      "types": "./lib/worker-plugin.d.ts",
      "default": "./lib/worker-plugin.js"
    },
    "./config": {
      "types": "./lib/config-plugin.d.ts",
      "default": "./lib/config-plugin.js"
    },
    "./hub-tool-guard": {
      "types": "./lib/hub-tool-guard.d.ts",
      "default": "./lib/hub-tool-guard.js"
    },
    "./web-tool-guard": {
      "types": "./lib/web-tool-guard.d.ts",
      "default": "./lib/web-tool-guard.js"
    },
    "./directory": {
      "types": "./lib/directory-plugin.d.ts",
      "default": "./lib/directory-plugin.js"
    },
    "./directory-index": {
      "types": "./lib/prompt-guard.d.ts",
      "default": "./lib/prompt-guard.js"
    },
    "./session-digest": {
      "types": "./lib/session-digest-watcher.d.ts",
      "default": "./lib/session-digest-watcher.js"
    },
    "./question-bridge": {
      "types": "./lib/question-bridge.d.ts",
      "default": "./lib/question-bridge.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@agent-society/agent-config": "^0.1.0",
    "@deepseek-ai/dsh": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@agent-society/agent-config": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
