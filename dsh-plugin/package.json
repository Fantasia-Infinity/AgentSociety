{
  "name": "@agent-society/dsh-agent-society",
  "version": "0.2.0",
  "description": "AgentSociety Hub worker and dispatch tools as a DeepSeek Harness bundle",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./task-bridge": {
      "types": "./lib/task-bridge.d.ts",
      "default": "./lib/task-bridge.js"
    },
    "./worker": {
      "types": "./lib/worker-plugin.d.ts",
      "default": "./lib/worker-plugin.js"
    },
    "./hub-tool-guard": {
      "types": "./lib/hub-tool-guard.d.ts",
      "default": "./lib/hub-tool-guard.js"
    },
    "./web-tool-guard": {
      "types": "./lib/web-tool-guard.d.ts",
      "default": "./lib/web-tool-guard.js"
    },
    "./directory": {
      "types": "./lib/directory-plugin.d.ts",
      "default": "./lib/directory-plugin.js"
    },
    "./directory-index": {
      "types": "./lib/prompt-guard.d.ts",
      "default": "./lib/prompt-guard.js"
    },
    "./session-digest": {
      "types": "./lib/session-digest-watcher.d.ts",
      "default": "./lib/session-digest-watcher.js"
    },
    "./question-bridge": {
      "types": "./lib/question-bridge.d.ts",
      "default": "./lib/question-bridge.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "0.0.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.0.1-rc.5",
    "@deepseek-ai/dsh-session-title": "^0.0.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
