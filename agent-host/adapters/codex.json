{
  "id": "codex",
  "display_name": "Codex CLI",
  "capabilities": ["code"],
  "command": ["codex", "exec"],
  "args": [
    "--skip-git-repo-check",
    "--sandbox",
    "{sandbox}",
    "--json",
    "{prompt}"
  ],
  "env": {},
  "result_mode": "stdout_json",
  "timeout_seconds": 3600,
  "cancel_grace_seconds": 10,
  "session": {
    "resume": true,
    "new_args": [
      "--skip-git-repo-check",
      "--sandbox",
      "{sandbox}",
      "--json",
      "{prompt}"
    ],
    "resume_args": [
      "--skip-git-repo-check",
      "--sandbox",
      "{sandbox}",
      "resume",
      "{session_id}",
      "--json",
      "{prompt}"
    ],
    "result_field": "session_id",
    "discovery_glob": "~/.codex/sessions/**/*.jsonl"
  }
}
