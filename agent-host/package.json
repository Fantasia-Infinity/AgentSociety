{
  "name": "@agent-society/agent-host",
  "version": "0.1.2",
  "type": "module",
  "description": "Optional thin AgentSociety management host for dsh",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fantasia-Infinity/AgentSociety.git",
    "directory": "agent-host"
  },
  "bin": {
    "agent": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "config",
    "adapters",
    "dsh",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/setup.mjs --bootstrap",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "apply-security-patches": "node scripts/patch-pi-brace-expansion.mjs",
    "security-check": "node scripts/patch-pi-brace-expansion.mjs --check",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build",
    "start": "node dist/src/cli.js",
    "interactive": "node dist/src/cli.js interactive",
    "tui": "node dist/src/cli.js tui",
    "web": "node dist/src/cli.js web",
    "web-bridge": "node dist/src/cli.js web-bridge",
    "connect": "node dist/src/cli.js connect",
    "sessions": "node dist/src/cli.js sessions",
    "doctor": "node dist/src/cli.js doctor",
    "worker": "node dist/src/cli.js worker",
    "bridge": "node dist/src/cli.js bridge",
    "dsh-worker": "node dist/src/cli.js dsh-worker",
    "dsh-once": "node dist/src/cli.js dsh-once",
    "dsh-dispatch": "node dist/src/cli.js dsh-dispatch",
    "dsh-doctor": "node dist/src/cli.js dsh-doctor"
  },
  "dependencies": {
    "@agent-society/agent-config": "^0.1.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@napi-rs/keyring": "1.3.0",
    "brace-expansion": "5.0.9",
    "pi-lsp-adapter": "0.1.3",
    "pi-mcp-adapter": "2.18.0",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
