{
  "name": "@ssh/agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Pi Agent Host with coordination Hub integration",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "apply-security-patches": "node scripts/patch-pi-brace-expansion.mjs",
    "security-check": "node scripts/patch-pi-brace-expansion.mjs --check",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "interactive": "node dist/src/cli.js interactive",
    "tui": "node dist/src/cli.js tui",
    "sessions": "node dist/src/cli.js sessions",
    "worker": "node dist/src/cli.js worker"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "brace-expansion": "5.0.9",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
