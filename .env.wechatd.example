# Identity and local HTTP API
WECHATD_ACCOUNT_ID=account-1
WECHATD_HTTP_HOST=127.0.0.1
WECHATD_HTTP_PORT=8742
# Optional bearer token for the local API; agents set AGENT_CHANNEL_HTTP_TOKEN
# to the same value. Leave empty to allow unauthenticated loopback access.
WECHATD_HTTP_TOKEN=

# mock runs on macOS/Linux/Windows. wxautox4 uses callback listening; wxauto4
# falls back to foreground polling when the free package has no callback API.
WECHAT_DRIVER=mock
WECHAT_LISTEN_CHATS=文件传输助手,测试群
WECHAT_BOT_MENTION=@机器人昵称
WECHAT_POLL_INTERVAL_SECONDS=1

# Send pacing (anti-risk-control) and request limits
WECHATD_SEND_MIN_INTERVAL_SECONDS=1
WECHATD_MAX_REQUEST_BYTES=65536
WECHATD_STATE_DB=.private/state/wechatd-state.sqlite3
