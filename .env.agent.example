# Running ./agent asks for these two non-secret model values and the API key.
# Only non-secret values and credential references are written to .env.agent.
# Canonical location: <repo>/.private/env/agent.env (legacy .env.agent still read).
AGENT_REMOTE_BASE_URL=https://api.example.com/v1
AGENT_REMOTE_MODEL=your-model-id

# Optional collaboration layer. Leave both unset for a normal standalone Agent.
# Setup asks for the Hub token only when a URL is supplied, then stores the token
# in the operating system credential store. Re-run setup later to add or remove it.
# AGENT_HUB_URL=https://hub.example.com

# Optional node-scoped token for worker operations (claim/update/heartbeat).
# Falls back to the shared Hub token when unset. Generate on the Hub with:
# POST /v1/hub/tenants/{tenant_id}/tokens  (role=node, actor_id, node_id)
# AGENT_HUB_NODE_TOKEN=

# Everything below is optional. The defaults derive identity from the signed-in
# user and hostname, use the cloned repository as workspace, and store Pi sessions
# below the user's home directory.
# AGENT_PRINCIPAL_ID=human-owner
# AGENT_PRINCIPAL_NAME=Owner
# AGENT_ACTOR_ID=pi-macbook
# AGENT_ACTOR_NAME="Pi on MacBook"
# AGENT_NODE_ID=macbook
# AGENT_NODE_NAME=MacBook

# AGENT_WORKSPACE_ROOT=/absolute/path/to/workspaces
# AGENT_SESSION_DIR=/absolute/path/to/pi-sessions

# TUI runtime: dsh (default when ../dsh-TUI and ../deepseek-harness
# checkouts plus ~/.dsh/plugins/agent-society exist) or pi.
# AGENT_TUI_RUNTIME=dsh
# AGENT_DSH_TUI_ROOT=/path/to/dsh-TUI

# Worker runtime: dsh-plugin (default for `./agent worker` when the
# agent-society-worker dsh profile is installed) or pi.
# AGENT_WORKER_RUNTIME=dsh-plugin
# AGENT_DSH_PLUGIN_PROFILE=agent-society-worker

# Remote task policy: no_tools, read_only, or full (default).
# full gives remote task sessions read, bash, edit, write, grep, find, ls and
# the collaboration Hub tools. Set read_only to restrict task sessions to
# read-only inspection tools (read/grep/find/ls) plus Hub tools.
# The dsh plugin worker maps this to AGENT_SOCIETY_TOOL_POLICY, and per-task
# input.tool_policy can override it.
# AGENT_REMOTE_TOOL_POLICY=full

# Model capabilities: context window, max output tokens, and default thinking
# level for Pi sessions (off, low, medium, high, xhigh, max). DeepSeek V4
# supports a 1M context window and high/max thinking levels.
# AGENT_MODEL_CONTEXT_WINDOW=1000000
# AGENT_MODEL_MAX_TOKENS=384000
# AGENT_THINKING_LEVEL=high

# Pi resources in Hub workers are disabled by default because Extensions execute
# with the signed-in user's permissions. Set global to load only user-installed
# ~/.pi/agent resources, or trusted_project to additionally load project resources
# that were approved earlier in a local TUI.
# AGENT_REMOTE_PI_RESOURCES=disabled
# AGENT_POLL_SECONDS=20
# AGENT_LEASE_SECONDS=300
# AGENT_WORKER_CONCURRENCY=1

# Dispatch-only hosts: set 1 to refuse starting a worker/bridge (receiving
# tasks) even if started manually. Dispatch through MCP/REST/Web still works.
# AGENT_HUB_RECEIVE_DISABLED=0

# Remote task session lifecycle. per_task creates one auditable Pi session for
# every Hub task. continuous keeps one resumable session per
# principal/workspace/worker slot, preserving context across sequential tasks.
# Set input.reset_worker_session=true on a task to rotate that scope manually.
# Values of 0 disable automatic task-count/age rotation.
# AGENT_WORKER_SESSION_MODE=per_task
# AGENT_WORKER_SESSION_MAX_TASKS=0
# AGENT_WORKER_SESSION_MAX_AGE_HOURS=0

# Codex bridge only: register a unified "AgentHub" project in the Codex desktop
# app (via `codex app ~/.agenthub/AgentHub`), attach every codex exec session to
# it, and rewrite exec session source to "cli" so the GUI shows them under
# AgentHub after restart (file + threads DB, with a one-time DB backup). Set
# AGENT_HUB_CODEX_PROJECT=0 to disable all of this.
# AGENT_HUB_CODEX_PROJECT=1
# AGENT_HUB_CODEX_PROJECT_NAME=AgentHub
# AGENT_HUB_CODEX_PROJECT_DIR=~/.agenthub/AgentHub
# AGENT_HUB_CODEX_PROJECT_SPAWN=1
# When AGENT_WORKSPACE_ROOT is unset, codex bridge defaults to
# AGENT_HUB_CODEX_PROJECT_DIR as its workspace.
# AGENT_ADAPTER_SANDBOX=workspace-write

# AgentSociety's managed capability bundle is enabled in every local session and
# every full-policy remote worker session. It supplies sub-agents, durable
# plan/todo state, scoped long-term memory, LSP/code navigation, MCP (including
# Channel tools), and session-owned background processes. Community/project Pi
# resource policy above remains independent. Set 0 only for a minimal host.
# AGENT_BUILTIN_CAPABILITIES=1
# AGENT_SUBAGENT_MAX_DEPTH=2
# AGENT_SUBAGENT_CONCURRENCY=4
# AGENT_BACKGROUND_MAX_PROCESSES=8
# Override only when automatic Python 3.11+ discovery cannot find the runtime
# used by the managed Channel MCP server. The resolved absolute executable path
# is stored in the non-secret Pi MCP config so Conda/PATH changes cannot break it.
# AGENT_PYTHON_COMMAND=/absolute/path/to/python3

# Provider-neutral web_search tool. auto enables DeepSeek's server-side
# Responses API search when AGENT_REMOTE_BASE_URL is api.deepseek.com, reusing
# the model credential from the system store. disabled removes the tool;
# deepseek forces the adapter for a compatible proxy/base URL.
# AGENT_WEB_SEARCH=auto
# AGENT_WEB_SEARCH_MODEL=deepseek-v4-flash

# Allow the worker to update itself when it claims a task with
# input.action="self_update". The worker pulls the repo, reinstalls pinned
# dependencies, reapplies the security patch, rebuilds, and restarts itself.
# Set to 0 to disable self-update entirely.
# AGENT_SELF_UPDATE=1

# Advanced alternative: select a provider already configured in Pi instead of the
# AGENT_REMOTE_* values above.
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-5

# DeepSeek Harness integration.
# dsh-dispatch launches `dsh web` with AgentSociety Hub MCP tools preconfigured.
# AGENT_DSH_COMMAND can be a JSON array for paths with spaces, e.g.
# AGENT_DSH_COMMAND='["node","/path/to/deepseek-harness/apps/cli/lib/bin.js"]'
# AGENT_DSH_COMMAND=dsh
#
# dsh-worker / dsh-once drive the dsh SDK JSON-RPC runtime. The shipped
# agent-host/config/dsh-worker.cordis.yml resolves plugins through the runtime
# installation named below (published bin: dsh-jsonrpc-agent).
# AGENT_DSH_RUNTIME_BIN=dsh-jsonrpc-agent
# AGENT_DSH_RUNTIME_ARGS=
# AGENT_DSH_CONFIG=/absolute/path/to/dsh-worker.cordis.yml
# AGENT_DSH_MODEL=deepseek-v4-flash
# AGENT_DSH_PROVIDER=deepseek-official
# AGENT_DSH_MAX_TOKENS=8192
# AGENT_DSH_SESSION_ROOT=/absolute/path/to/dsh-sessions
# Default none keeps transcripts readable by `./agent observe`; zstd saves disk.
# AGENT_DSH_SESSION_COMPRESSION=none
# AGENT_DSH_PERMISSION_MODE=workspace-write
# Hub MCP and web_search default to enabled. Set 0 to disable explicitly.
# AGENT_DSH_HUB_MCP=0
# AGENT_DSH_WEB_SEARCH=0

# Setup generates these non-secret references automatically. Credentials live in
# macOS Keychain, Windows Credential Manager, or Linux Secret Service.
# AGENT_REMOTE_API_KEY_CREDENTIAL_SERVICE="AgentSociety Remote LLM API"
# AGENT_REMOTE_API_KEY_CREDENTIAL_ACCOUNT=owner
# AGENT_HUB_TOKEN_CREDENTIAL_SERVICE="AgentSociety Hub"
# AGENT_HUB_TOKEN_CREDENTIAL_ACCOUNT=owner

# ── Shared context / directory / questions (feat/shared-context) ──────────
# Worker writes deterministic consensus digests after each task run.
# AGENT_SOCIETY_CONTEXT=0 disables consensus digests (default: enabled)
# Session directory sync (push local rows, pull the mirror) and the bounded
# prompt injection guard. AGENT_SOCIETY_DIRECTORY=0 disables both.
# AGENT_SOCIETY_DIRECTORY_PULL_SECONDS=10
# Answer Hub questions addressed to this actor (worker + interactive bridge).
# AGENT_SOCIETY_QUESTIONS=0 disables answering entirely.
# Question policy for interactive processes: auto (answer while unattended,
# leave for the human card when present), ask (always ask the human),
# standalone (always auto-answer).
# AGENT_SOCIETY_QUESTION_POLICY=auto
# AGENT_SOCIETY_QUESTION_POLL_SECONDS=10
