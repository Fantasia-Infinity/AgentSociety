# These are the only three values a new user needs to provide. Running ./agent
# prompts for them and writes .env.agent automatically; manual editing is optional.
AGENT_REMOTE_BASE_URL=https://api.example.com/v1
AGENT_REMOTE_MODEL=your-model-id
AGENT_REMOTE_API_KEY=replace-with-model-api-key

# Optional collaboration layer. Leave both unset for a normal standalone Agent.
# Re-run ./agent setup later to add or remove Hub integration.
# AGENT_HUB_URL=https://hub.example.com
# AGENT_HUB_TOKEN=replace-with-at-least-24-random-characters

# Everything below is optional. The defaults derive identity from the signed-in
# user and hostname, use the cloned repository as workspace, and store Pi sessions
# below the user's home directory.
# AGENT_PRINCIPAL_ID=human-owner
# AGENT_PRINCIPAL_NAME=Owner
# AGENT_ACTOR_ID=pi-macbook
# AGENT_ACTOR_NAME="Pi on MacBook"
# AGENT_NODE_ID=macbook
# AGENT_NODE_NAME=MacBook

# AGENT_WORKSPACE_ROOT=/absolute/path/to/workspaces
# AGENT_SESSION_DIR=/absolute/path/to/pi-sessions

# Remote task policy: no_tools, read_only (default), or full.
# Local interactive sessions always expose Pi's normal coding tools.
# AGENT_REMOTE_TOOL_POLICY=read_only
# AGENT_POLL_SECONDS=20
# AGENT_LEASE_SECONDS=300

# Advanced alternative: select a provider already configured in Pi instead of the
# AGENT_REMOTE_* values above.
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-5

# Advanced macOS alternative: keep credentials in Login Keychain.
# AGENT_HUB_TOKEN_KEYCHAIN_SERVICE=agent-hub-token
# AGENT_HUB_TOKEN_KEYCHAIN_ACCOUNT="your keychain account"
# AGENT_REMOTE_API_KEY_KEYCHAIN_SERVICE=your-keychain-service
# AGENT_REMOTE_API_KEY_KEYCHAIN_ACCOUNT="your keychain account"
