# Standalone Coordination Hub. Bind loopback and publish it through HTTPS.
AGENT_HUB_HOST=127.0.0.1
AGENT_HUB_PORT=8090
AGENT_HUB_TOKEN=replace-with-at-least-24-random-characters
AGENT_HUB_STATE_DB=hub-state.sqlite3

# Only use true for a deliberately firewalled direct bind. A reverse proxy does
# not need it because Hub itself remains on loopback.
AGENT_HUB_ALLOW_NON_LOOPBACK_BIND=false
