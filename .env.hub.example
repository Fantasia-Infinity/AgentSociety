# Canonical Hub configuration example (standalone and public deployment).
# Copy it as `.env.hub` next to the repository root:
#   cp .env.hub.example .env.hub

# --- Listen address (standalone mode) ---
# Standalone Hub binds loopback and is exposed through a reverse proxy or
# tunnel. AGENT_HUB_HOST/AGENT_HUB_PORT are ignored by the Docker Compose
# deployment (see deploy/hub/compose.yaml, which reads deploy/hub/.env.hub).
# Direct runs load `.env.hub` then `.private/env/hub.env` (private copy wins).
AGENT_HUB_HOST=127.0.0.1
AGENT_HUB_PORT=8090
AGENT_HUB_TOKEN=replace-with-at-least-24-random-characters
AGENT_HUB_STATE_DB=.private/state/hub-state.sqlite3
# Only use true for a deliberately firewalled direct bind. A reverse proxy does
# not need it because Hub itself remains on loopback.
AGENT_HUB_ALLOW_NON_LOOPBACK_BIND=false

# --- Public URL and TLS (public deployment, deploy/hub) ---
# Public URL seen by devices and returned by the A2A Agent Card.
# Cloudflare quick-tunnel mode: the random https://<id>.trycloudflare.com URL
# printed by `docker compose --env-file .env.hub logs cloudflared`
# (changes on every restart).
# Cloudflare named-tunnel mode / direct Caddy mode:
#   https://hub.example.com
# AGENT_HUB_PUBLIC_URL=https://<id>.trycloudflare.com

# TLS mode is only used by the optional Caddy profile:
#           self-signed (default, requires AGENT_HUB_PUBLIC_IP)
#           letsencrypt (requires AGENT_HUB_DOMAIN)
# AGENT_HUB_TLS_MODE=self-signed
# AGENT_HUB_PUBLIC_IP=203.0.113.10
# AGENT_HUB_DOMAIN=hub.example.com

# --- Cloudflare Tunnel (public deployment, deploy/hub) ---
# Expose the Hub through Cloudflare without opening any host ports.
# The default `cloudflared` service runs a quick tunnel: temporary random
# trycloudflare.com URL, no account/domain. The URL is printed by:
#   docker compose --env-file .env.hub logs cloudflared
# For a stable hostname, create the tunnel in Cloudflare Zero Trust and
# configure its public hostname ingress to http://agent-hub:8090, then run:
#   docker compose --env-file .env.hub --profile named-tunnel up -d cloudflared-named
# AGENT_HUB_CLOUDFLARE_TUNNEL_TOKEN=

# --- Scale-out storage ---
# Optional PostgreSQL. SQLite and URI-only artifacts remain the default.
# Install with `pip install -e '.[postgres]'` before enabling PostgreSQL.
# AGENT_HUB_DATABASE_URL=postgresql://user:password@127.0.0.1/agent_society
# For Docker Compose, the postgres service credentials come from:
# AGENT_HUB_POSTGRES_USER=agenthub
# AGENT_HUB_POSTGRES_PASSWORD=replace-with-a-long-random-password
# AGENT_HUB_POSTGRES_DB=agenthub

# Optional S3-compatible object storage for Artifact contents.
# Install with `pip install -e '.[s3]'`.
# AGENT_HUB_OBJECT_STORE_URL=file:///absolute/path/to/hub-objects
# AGENT_HUB_OBJECT_STORE_URL=s3://your-bucket/prefix
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Web management UI ---
# Required to enable /web; at least 32 random characters.
# AGENT_HUB_WEB_SECRET=replace-with-at-least-32-random-characters
# Set false only for local plain-HTTP debugging.
# AGENT_HUB_WEB_COOKIE_SECURE=true

# --- Security hardening ---
# Public self-registration. true lets anyone create an isolated account in the
# default tenant; for a personal/team deployment prefer false and keep the
# single administrator account.
# AGENT_HUB_ALLOW_REGISTRATION=true
# Throttle authentication endpoints per source IP. The first registered user
# of a tenant becomes its tenant_admin, so on a fresh public deployment either
# register your admin account first or keep registration disabled until then.
# AGENT_HUB_RATE_LIMIT=true
# AGENT_HUB_RATE_LIMIT_AUTH_PER_MINUTE=20
# AGENT_HUB_RATE_LIMIT_REGISTER_PER_HOUR=10

# --- MCP server for external agents (Codex/OpenCode/Claude) ---
# AGENT_HUB_ENABLE_MCP=true

# --- Optional OIDC login for the web UI and API ---
# The token's "sub" must be pre-registered via hub_oidc_identities
# (register_oidc_identity). Install with `pip install -e '.[oidc]'`.
# AGENT_HUB_OIDC_ISSUER=https://accounts.example.com
# AGENT_HUB_OIDC_AUDIENCE=agent-society-hub
