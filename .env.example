# Bot Core HTTP API
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8080
BOT_API_TOKEN=zxcvbnm
BOT_WORKERS=2
BOT_QUEUE_SIZE=100
BOT_STATE_DB=core-state.sqlite3

# Safe-by-default access control. Use explicit IDs; "*" allows every ID.
BOT_ALLOWED_USERS=test-user-id
BOT_ALLOWED_GROUPS=test-group-id
BOT_GROUP_REQUIRE_MENTION=true

# Remote OpenAI-compatible API used by the first implementation.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=your-chat-model
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024

# Conversation behavior
BOT_SYSTEM_PROMPT=You are a concise and helpful assistant responding through WeChat.
BOT_MAX_HISTORY_MESSAGES=20
