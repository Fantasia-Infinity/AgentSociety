# Bot Core HTTP API
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8080
BOT_API_TOKEN=replace-with-shared-random-token
BOT_WORKERS=2
BOT_QUEUE_SIZE=100
BOT_STATE_DB=core-state.sqlite3

# Agent Hub is loopback-only by default even if BOT_API_HOST is 0.0.0.0.
# Use a different token before explicitly enabling trusted remote nodes.
AGENT_HUB_TOKEN=replace-with-a-separate-random-token
AGENT_HUB_ALLOW_REMOTE=false

# Safe-by-default access control. Use explicit IDs; "*" allows every ID.
BOT_ALLOWED_USERS=test-user-id
BOT_ALLOWED_GROUPS=test-group-id
BOT_GROUP_REQUIRE_MENTION=true

# Model routing: remote, local_rwkv, or auto.
# auto tries the local model first and explicitly permits remote fallback.
LLM_BACKEND=remote

# Remote OpenAI-compatible API. Existing deployments remain on this backend.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=your-chat-model
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CONCURRENCY=4

# Local OpenAI-compatible endpoint used by local_rwkv and auto modes.
# The local server deliberately uses port 18080 because Bot Core uses 8080.
LOCAL_LLM_BASE_URL=http://127.0.0.1:18080/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=rwkv-local
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_TEMPERATURE=1.0
LOCAL_LLM_MAX_OUTPUT_TOKENS=512
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_TOP_P=0.5
LOCAL_LLM_REPEAT_PENALTY=1.2
LOCAL_LLM_HEALTH_URL=http://127.0.0.1:18080/health
LOCAL_LLM_HEALTH_TIMEOUT_SECONDS=2

# llama-server process settings. Required only when this project launches it.
LOCAL_LLM_EXECUTABLE=/opt/homebrew/bin/llama-server
LOCAL_LLM_MODEL_PATH=/absolute/path/to/rwkv-model.gguf
LOCAL_LLM_BIND_HOST=127.0.0.1
LOCAL_LLM_PORT=18080
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=8
LOCAL_LLM_GPU_LAYERS=99
LOCAL_LLM_CHAT_TEMPLATE=rwkv-world

# Conversation behavior
BOT_SYSTEM_PROMPT=You are a concise and helpful assistant responding through WeChat.
BOT_MAX_HISTORY_MESSAGES=20
