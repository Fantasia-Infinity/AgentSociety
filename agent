#!/bin/sh
set -eu

script_path=$0
case "$script_path" in
    */*) ;;
    *) script_path=$(command -v "$script_path") ;;
esac
while [ -L "$script_path" ]; do
    script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
    link_target=$(readlink "$script_path")
    case "$link_target" in
        /*) script_path=$link_target ;;
        *) script_path="$script_dir/$link_target" ;;
    esac
done
repository_root=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
agent_host="$repository_root/agent-host"
command=${1:-tui}
if [ "$#" -gt 0 ]; then
    shift
fi

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "Node.js 22.19 or newer and npm are required." >&2
    exit 1
fi

install_global_command() {
    global_bin=${AGENT_GLOBAL_BIN:-"${HOME}/.local/bin"}
    global_command="$global_bin/agent"

    mkdir -p "$global_bin"
    if [ -e "$global_command" ] || [ -L "$global_command" ]; then
        existing_target=$(readlink "$global_command" 2>/dev/null || true)
        if [ "$existing_target" = "$repository_root/agent" ]; then
            : # already installed as a symlink to this repository
        elif [ -f "$global_command" ] && cmp -s "$global_command" "$repository_root/agent"; then
            : # installed copy produced by the Git Bash/MSYS ln -s fallback
        else
            echo "Refusing to overwrite existing command: $global_command" >&2
            return 1
        fi
    else
        ln -s "$repository_root/agent" "$global_command"
    fi

    echo "Global command available as: $global_command" >&2
    case ":${PATH:-}:" in
        *:"$global_bin":*) ;;
        *) echo "Add $global_bin to PATH to run 'agent' from any directory." >&2 ;;
    esac
}

agent_config_path() {
    if [ -n "${AGENT_ENV_FILE:-}" ]; then
        printf '%s\n' "$AGENT_ENV_FILE"
    elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
        printf '%s\n' "$XDG_CONFIG_HOME/agentsociety/agent.env"
    else
        printf '%s\n' "${HOME}/.config/agentsociety/agent.env"
    fi
}

has_agent_config() {
    config_path=$(agent_config_path)
    [ -f "$config_path" ] || \
      [ -f "$repository_root/.private/env/agent.env" ] || \
      [ -f "$repository_root/.env.agent" ]
}

bootstrap_if_needed() {
    if [ ! -d "$agent_host/node_modules" ] || [ ! -f "$agent_host/dist/src/cli.js" ]; then
        npm --prefix "$agent_host" run bootstrap
    fi
}

bootstrap_runtime() {
    npm --prefix "$agent_host" run bootstrap
}

if [ "$command" = "bootstrap" ] || [ "$command" = "repair" ]; then
    bootstrap_runtime
    install_global_command
    exit 0
fi

if [ "$command" = "setup" ] || [ "$command" = "configure" ]; then
    bootstrap_if_needed
    npm --prefix "$agent_host" run setup -- "$@"
    install_global_command
    exit 0
fi

did_setup=0
bootstrap_if_needed
if [ "$command" != "doctor" ] && [ "$command" != "sessions" ] && ! has_agent_config; then
    npm --prefix "$agent_host" run setup
    did_setup=1
fi
install_global_command

case "$command" in
    tui|interactive|local)
        exec npm --prefix "$agent_host" run start -- "$command"
        ;;
    worker)
        exec npm --prefix "$agent_host" run worker
        ;;
    web|web-bridge)
        exec npm --prefix "$agent_host" run start -- "$command" "$@"
        ;;
    web-bridge)
        exec npm --prefix "$agent_host" run web-bridge -- "$@"
        ;;
    doctor)
        exec node "$agent_host/dist/src/cli.js" doctor "$@"
        ;;
    dsh-doctor|sessions)
        exec npm --prefix "$agent_host" run start -- "$command" "$@"
        ;;
    register|once|observe|attach|bridge|connect|steer|follow-up|cancel|control|dsh-worker|dsh-once|dsh-dispatch|dsh-doctor)
        exec npm --prefix "$agent_host" run start -- "$command" "$@"
        ;;
    *)
        echo "Usage: ./agent [setup|configure|bootstrap|repair|tui|web|web-bridge|local|worker|connect|bridge --adapter ID|doctor [--live] [--json]|dsh-doctor|sessions|register|once|observe ID|attach ID|steer|follow-up|cancel|control|dsh-worker|dsh-once|dsh-dispatch]" >&2
        exit 2
        ;;
esac
